# Shell scripts must keep LF endings (a CRLF shebang breaks under Git Bash/WSL)
*.sh text eol=lf

# Everything else is stored and checked out with LF so Windows and CI agree and git stops warning about CRLF
* text=auto eol=lf
# Windows batch files need CRLF
*.bat text eol=crlf
# Binary assets are never converted
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.keystore binary
*.jks binary
*.fmbk binary
